# ==============================================================================
# Multi-Document RAG Assistant Configuration
# Copy this file to '.env' and adjust values as needed for your environment.
# ==============================================================================

# ==============================================================================
# PRODUCTION CLOUD ARCHITECTURE (ZERO PREPAID CREDITS)
# Render Backend + Groq API (High Speed LLM) + Local CPU ONNX Embeddings
# ==============================================================================
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (OLLAMA)
# Uncomment below to run locally with Ollama instead of Groq/local ONNX.
# ==============================================================================
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:1b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=180.0
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ==============================================================================
# OPTIONAL: GOOGLE GEMINI CLOUD PROVIDER
# ==============================================================================
# LLM_PROVIDER=cloud
# LLM_MODEL=gemini-3.6-flash
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=your_gemini_api_key_here
# EMBEDDING_PROVIDER=cloud
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_DIMENSIONS=768

# ==============================================================================
# VECTOR STORAGE & DATABASE SETTINGS
# Note: On Render free tier, local disk storage is ephemeral across deploys/restarts.
# ==============================================================================
CHROMA_PATH=./chroma_db
COLLECTION_NAME=documents
DOCUMENTS_DIR=./documents
DATABASE_PATH=./data/rag_app.db
UPLOAD_DIR=./data/uploads

# ==============================================================================
# CHUNKING & RETRIEVAL CONFIGURATION
# ==============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
LOG_LEVEL=INFO

# ==============================================================================
# API & CORS SETTINGS (JSON string array or comma-separated URLs)
# Include your Vercel frontend URL in production, e.g.:
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-app.vercel.app"]
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
