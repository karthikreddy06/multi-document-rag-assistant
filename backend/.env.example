# ==============================================================================
# Multi-Document RAG Assistant Configuration
# Copy this file to '.env' and adjust values as needed for your environment.
# ==============================================================================

# Ollama Service Configuration
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

# Client Timeout (in seconds) for Ollama requests (prevents hanging on model-swapping)
OLLAMA_TIMEOUT=60.0

# Vector Storage & Document Directory Settings
CHROMA_PATH=./chroma_db
COLLECTION_NAME=documents
DOCUMENTS_DIR=./documents

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval & System Configuration
TOP_K=5
LOG_LEVEL=INFO

# API & CORS Settings (JSON string array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
