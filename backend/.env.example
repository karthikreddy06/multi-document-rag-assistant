# ==============================================================================
# Multi-Document RAG Assistant Configuration
# Copy this file to '.env' and adjust values as needed for your environment.
# ==============================================================================

# ==============================================================================
# LOCAL OLLAMA CONFIGURATION (DEFAULT FOR LOCAL DEVELOPMENT)
# ==============================================================================
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:1b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=180.0

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# PRODUCTION CLOUD CONFIGURATION (ZERO-COST PORTFOLIO DEPLOYMENT)
# Set LLM_PROVIDER=cloud and EMBEDDING_PROVIDER=cloud to enable cloud providers.
# Example: Groq Cloud LLM (Free Tier: 14.4k req/day) + Google Gemini Embedding
# ==============================================================================
# LLM_PROVIDER=cloud
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key_here

# EMBEDDING_PROVIDER=cloud
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EMBEDDING_API_KEY=your_gemini_api_key_here

# ==============================================================================
# VECTOR STORAGE & DATABASE SETTINGS
# ==============================================================================
CHROMA_PATH=./chroma_db
COLLECTION_NAME=documents
DOCUMENTS_DIR=./documents
DATABASE_PATH=./data/rag_app.db
UPLOAD_DIR=./data/uploads

# ==============================================================================
# CHUNKING & RETRIEVAL CONFIGURATION
# ==============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
LOG_LEVEL=INFO

# ==============================================================================
# API & CORS SETTINGS (JSON string array)
# ==============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
